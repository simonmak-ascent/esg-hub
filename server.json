{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.simonmak-ascent/esg-hub",
  "title": "ESG Hub MCP Server",
  "description": "ESG knowledge base for AI agents: hybrid search, glossary, frameworks, industries, graph traversal.",
  "version": "1.4.1",
  "websiteUrl": "https://esg-hub.ascent.partners",
  "repository": {
    "url": "https://github.com/simonmak-ascent/esg-hub",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://esg-hub.ascent.partners/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@simonmak-ascent/esg-hub-mcp",
      "version": "1.4.1",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/simonmak-ascent/esg-hub/main/public/icon-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ]
}
