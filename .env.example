# ESG Hub — environment variable template
# Copy to .env (gitignored) and fill in your own values.
# NEVER commit real values — this file is names/placeholders only.

# --- SurrealDB Cloud (required for dev, build, and scripts) ---
SURREAL_URL=https://your-instance.surrealdb.cloud
SURREAL_USERNAME=your-username
SURREAL_PASSWORD=your-password
SURREAL_DATABASE=main
# NOTE: the namespace is hardcoded to "esg_hub" in app code and scripts.
# SURREAL_NAMESPACE is intentionally ignored to avoid cross-project shadowing.
# Scripts override only via: ESG_HUB_NS_OVERRIDE=some_namespace

# --- AI features ---
# DeepSeek (LLM answer generation for /api/ai-search and /api/ai-chat)
DEEPSEEK_API_KEY=
# Brave Search API (web results for AI search)
BRAVE_API_KEY=

# --- Site ---
# Public base URL for sitemap/canonical (optional in dev)
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SITE_URL=
